# ── Database ────────────────────────────────────────────────────────
# For local dev (direct connection, non-Docker backend):
DATABASE_URL=postgresql://reflex:reflex@localhost:5433/reflex
# Docker Compose overrides this to: postgresql://reflex:reflex@postgres:5432/reflex
POSTGRES_PASSWORD=reflex

# ── GitHub OAuth App ────────────────────────────────────────────────
# Create at https://github.com/settings/developers
# Homepage URL:           http://localhost:3000
# Authorization callback: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=__fill_me__
GITHUB_CLIENT_SECRET=__fill_me__

# ── JWT ─────────────────────────────────────────────────────────────
# Secret for signing session cookies — generate with: openssl rand -hex 32
JWT_SECRET=change-me-locally

# ── Gemini (Google AI Studio) ───────────────────────────────────────
GEMINI_API_KEY=__fill_me__
GEMINI_MODEL=gemini-3.1-flash

# ── Origins ─────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001
PORT=3001

# ── Docker Compose Ports (optional) ────────────────────────────────
# POSTGRES_PORT=5433
# FRONTEND_PORT=3000
